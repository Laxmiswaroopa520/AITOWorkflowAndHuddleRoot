{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<YOUR-TENANT-ID>",
    "ClientId": "<YOUR-BACKEND-API-CLIENT-ID>",
    "Audience": "api://<YOUR-BACKEND-API-CLIENT-ID>"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=;Database=AitoWorkflowAndHuddleGeneratorDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}


/*AzureAd:ClientId
    = Backend Web API app registration client ID

Not:
    Frontend SPA client ID*/


